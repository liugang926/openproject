<% if User.current.pref.sync_with_os_theme? %>
  <%# Mirrors AutoThemeSwitcher#applySystemTheme; both must stamp the same attributes. %>
  <%= nonced_javascript_tag do %>
    (() => {
      const body = document.body;
      const data = body.dataset;
      const mode = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      const forced = data[`autoThemeSwitcherForce${mode === 'light' ? 'Light' : 'Dark'}ContrastValue`] === 'true';
      const highContrast = matchMedia('(prefers-contrast: more)').matches || forced;

      body.setAttribute('data-color-mode', mode);
      body.setAttribute(`data-${mode}-theme`, highContrast ? `${mode}_high_contrast` : mode);
      body.removeAttribute(`data-${mode === 'light' ? 'dark' : 'light'}-theme`);
    })();
  <% end %>
<% end %>
